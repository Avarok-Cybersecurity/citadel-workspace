{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avarok.net/contracts/batch-1116/tray-tab-manifest.schema.json",
  "title": "Avarok tray tab manifest",
  "description": "Plan §5.4 as tray-core (avarok-desktop) implements it. The file is <id>.json under the per-user tabs directory, at most 64 KiB. sig = FIPS 204 ML-DSA-65 with context \"avarok-tab-manifest-v1\" over the RFC 8949 deterministic CBOR of every field but sig; the publisher key must be one the host pins and the name must match it. Absent optional fields are absent, never null. What a schema cannot say is in tray-tab-manifest.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\p{Cc}]+$"
    },
    "icon_template_png": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "minLength": 12,
      "maxLength": 21848,
      "description": "standard base64 of a PNG (starts with the PNG magic) of at most 16 KiB"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "mldsa65_public_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{3904}$"
        }
      },
      "required": [
        "name",
        "mldsa65_public_key"
      ]
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "macos_bundle_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"
        },
        "macos_team_id": {
          "type": "string",
          "pattern": "^[A-Z0-9]{10}$"
        },
        "windows_exe": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^%(?:ProgramFiles|ProgramFiles\\(x86\\)|LOCALAPPDATA%\\\\Programs)%?\\\\(?!.*(?:^|\\\\)\\.\\.?(?:\\\\|$))[^\\\\\\x00-\\x1f]+(?:\\\\[^\\\\\\x00-\\x1f]+)*\\.exe$",
          "description": "under %ProgramFiles%\\, %ProgramFiles(x86)%\\ or %LOCALAPPDATA%\\Programs; no . or .. segment"
        },
        "windows_publisher_thumbprint": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "linux_exec": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^(?:/usr/|/opt/|~/\\.local/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\x00-\\x1f]+(?:/[^/\\x00-\\x1f]+)*$",
          "description": "under /usr/, /opt/ or ~/.local/; no . or .. segment; not writable by others (checked by the host)"
        }
      },
      "required": [],
      "anyOf": [
        {
          "required": [
            "macos_bundle_id",
            "macos_team_id"
          ]
        },
        {
          "required": [
            "windows_exe",
            "windows_publisher_thumbprint"
          ]
        },
        {
          "required": [
            "linux_exec"
          ]
        }
      ],
      "description": "At least one platform, each platform complete."
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argv": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^[^\\x00]*$"
          }
        },
        "ready": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "tcp"
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            }
          },
          "required": [
            "kind",
            "port"
          ]
        },
        "crash_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "argv",
        "ready",
        "crash_cap"
      ]
    },
    "panel": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "web"
            },
            "url": {
              "type": "string",
              "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{3,4}/[\\x21-\\x7e]*$",
              "maxLength": 1024,
              "description": "the loopback port must equal agent.ready.port (checked by the host)"
            },
            "token": {
              "const": "stdout-handshake"
            }
          },
          "required": [
            "kind",
            "url",
            "token"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "native"
            },
            "macos_module": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            }
          },
          "required": [
            "kind",
            "macos_module"
          ]
        }
      ]
    },
    "actions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\p{Cc}]+$"
          },
          "launch": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "macos_open_bundle": {
                "type": "boolean"
              },
              "url_fragment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^#[\\x21-\\x7e]*$"
              }
            },
            "required": [
              "macos_open_bundle"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "launch"
        ]
      }
    },
    "sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 4412,
      "maxLength": 4412
    }
  },
  "required": [
    "format",
    "id",
    "title",
    "icon_template_png",
    "publisher",
    "app",
    "agent",
    "panel",
    "actions",
    "sig"
  ]
}
