<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>net.avarok.citadel-agent</string>
	<key>CFBundleName</key>
	<string>Citadel Agent</string>
	<key>CFBundleDisplayName</key>
	<string>Citadel Agent</string>
	<key>CFBundleExecutable</key>
	<string>Citadel Agent</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<!-- A menu-bar app: no Dock icon, no app menu. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Shown by macOS when the agent first reaches the local network: a workspace server or a
	     colleague's agent on the same Wi-Fi. Without approval macOS refuses those connections with
	     "No route to host", while the internet still works (reproduced 2026-09-27), so the words
	     have to make the choice easy to understand. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Citadel Agent connects directly to other members and to workspace servers on your local network, so calls, messages and files between people nearby do not go through a relay.</string>
	<key>NSHumanReadableCopyright</key>
	<string>© Avarok Cybersecurity</string>
	<!-- What the launcher runs the agent with (Support.swift). Each is required. -->
	<key>CitadelWorkspaceOrigin</key>
	<string>https://work.avarok.net</string>
	<key>CitadelAgentBind</key>
	<string>127.0.0.1:12345</string>
	<key>CitadelAgentDataDirectoryName</key>
	<string>.citadel-agent</string>
	<key>CitadelAgentStunServers</key>
	<string>stun.cloudflare.com:3478,stun1.l.google.com:19302,stun4.l.google.com:19302</string>
</dict>
</plist>
