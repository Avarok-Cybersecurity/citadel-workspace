{
  "format": 1,
  "id": "net.avarok.calendar",
  "version": "0.1.0",
  "sdk": {
    "abi": "wasm-bindgen-glue-firstparty",
    "min": "0.1.0",
    "max": "0.x"
  },
  "publisher": {
    "name": "Avarok",
    "mldsa65_public_key": "",
    "contact": "https://avarok.net"
  },
  "name": "Calendar",
  "summary": "Events, booking pages and free/busy on every page",
  "description": "A calendar on each page: its events and the ones it inherits from the pages above, your booking page and event types, and bookings that reach a host while they are online.\nOther apps add and read events through the Calendar SDK.",
  "icon": {
    "png_base64": "iVBORw0KGgoAAAANSUhEUgAAACAAAAAgCAYAAABzenr0AAAAU0lEQVR42mNgGAWDBdz0sP5PTzzqgFEHjDoAwwHRidn/kYF2zk0wRgfUEAfZRdABtASjDiDKAQOeBkYT4agDRhPhaBoYTYSjiXBkOoCeeLQvCgMANOG1cEtT1LMAAAAASUVORK5CYII=",
    "max_bytes": 65536
  },
  "categories": [
    "planning"
  ],
  "audience": {
    "kind": "workspace"
  },
  "surfaces": [
    "node_tab"
  ],
  "opens": {
    "extensions": [
      "ics"
    ],
    "surface": "node_tab",
    "max_bytes": 1048576
  },
  "scopes": [
    "workspace"
  ],
  "capabilities": [
    {
      "cap": "storage.user",
      "why": "Your availability, your booking pages and your private events",
      "optional": false
    },
    {
      "cap": "storage.node",
      "why": "This page's events and event types",
      "optional": false
    },
    {
      "cap": "storage.node.authored",
      "why": "Events, bookings and free/busy you post on a page",
      "optional": false
    },
    {
      "cap": "nodes.read",
      "why": "Which pages are above and below this one, to show inherited events",
      "optional": false
    },
    {
      "cap": "members.list",
      "why": "Who can be a host or an invitee",
      "optional": false
    },
    {
      "cap": "notifications",
      "why": "Reminders and booking confirmations",
      "optional": false
    },
    {
      "cap": "ihttp.serve",
      "routes": [
        "POST /book",
        "POST /book/:id/cancel",
        "POST /book/:id/reschedule",
        "GET /events",
        "POST /events",
        "PATCH /events/:id",
        "DELETE /events/:id",
        "GET /free-busy",
        "GET /health"
      ],
      "why": "Takes bookings while you are online and answers other apps",
      "optional": false
    },
    {
      "cap": "ihttp.call",
      "targets": [],
      "why": "Books with a host while they are online",
      "optional": false
    },
    {
      "cap": "group.topic.subscribe",
      "topics": [
        "cal"
      ],
      "why": "Hears changes to this page's calendar",
      "optional": false
    },
    {
      "cap": "group.topic.publish",
      "topics": [
        "cal"
      ],
      "why": "Says this page's calendar changed",
      "optional": false
    },
    {
      "cap": "documents",
      "why": "Meeting notes as a live document",
      "optional": true
    }
  ],
  "limits": {
    "memory_pages": 512,
    "max_call_rate_per_s": 30,
    "frame_budget_ms": 16,
    "storage_user_bytes": 1048576,
    "storage_scope_bytes": 0,
    "close_grace_ms": 1000,
    "topics": {
      "max_msg_bytes": 1024,
      "max_msgs_per_s": 2
    }
  },
  "artifact": {
    "sha256": "f8c2094943535467f3058facf4f96966435973c55b252131b9d8014d5eaf2c89",
    "bytes": 1034395,
    "locations": [
      {
        "kind": "https",
        "url": "https://github.com/Avarok-Cybersecurity/citadel-workspace-ui/raw/master/public/calendar/calendar_glue_bg.wasm"
      }
    ]
  }
}
