{
  "format": 1,
  "id": "net.avarok.compute-pool",
  "version": "0.1.0",
  "sdk": {
    "abi": "citadel-app-abi-1",
    "min": "0.1.0",
    "max": "0.x"
  },
  "publisher": {
    "name": "Avarok",
    "mldsa65_public_key": "",
    "contact": "https://avarok.net"
  },
  "name": "Compute Pool",
  "summary": "Share deterministic jobs with the members who run it",
  "description": "Splits a job into chunks and hands them to the other members running Compute Pool, peer to peer where it can and through the workspace relay where it cannot.\nOne chunk of every job is recomputed here, so a wrong answer shows.",
  "icon": {
    "png_base64": "iVBORw0KGgoAAAANSUhEUgAAACAAAAAgCAYAAABzenr0AAAARElEQVR42mOosXr7Hx8WW+yFF1Oqn2HUAaMOGHXAgDuA1hYQ0j/qgFEHjDpg4B0wWhKOOmDUAaMOGC0JRx0w6oAR7wAAVIxIiOllY/oAAAAASUVORK5CYII=",
    "max_bytes": 65536
  },
  "categories": [
    "utilities"
  ],
  "audience": {
    "kind": "workspace"
  },
  "surfaces": [
    "canvas_pane",
    "md_zone"
  ],
  "scopes": [
    "workspace",
    "node"
  ],
  "capabilities": [
    {
      "cap": "canvas",
      "why": "Draws the pool's dashboard",
      "optional": false
    },
    {
      "cap": "storage.user",
      "why": "Keeps your last 50 jobs",
      "optional": false
    },
    {
      "cap": "storage.scope",
      "why": "Counts the jobs each member finished, for everyone in the pool",
      "optional": false
    },
    {
      "cap": "ihttp.serve",
      "routes": [
        "POST /job/primes",
        "POST /job/sha-chain",
        "POST /job/chunks",
        "GET /health"
      ],
      "why": "Answers job chunks other members send through the workspace relay",
      "optional": true
    },
    {
      "cap": "ihttp.call",
      "targets": [],
      "why": "Sends job chunks through the workspace relay when a direct connection is not possible",
      "optional": true
    },
    {
      "cap": "ihttp.p2p.serve",
      "routes": [
        "POST /job/primes",
        "POST /job/sha-chain",
        "POST /job/chunks",
        "GET /health"
      ],
      "why": "Answers job chunks other members send straight to this device",
      "optional": false
    },
    {
      "cap": "ihttp.p2p.call",
      "targets": [],
      "why": "Sends job chunks straight to other members' devices",
      "optional": false
    },
    {
      "cap": "group.topic.subscribe",
      "topics": [
        "pool"
      ],
      "why": "Hears who is in the pool and which jobs need hands",
      "optional": false
    },
    {
      "cap": "group.topic.publish",
      "topics": [
        "pool"
      ],
      "why": "Says this device is in the pool and claims chunks",
      "optional": false
    }
  ],
  "limits": {
    "memory_pages": 256,
    "max_call_rate_per_s": 30,
    "frame_budget_ms": 16,
    "storage_user_bytes": 262144,
    "storage_scope_bytes": 1048576,
    "close_grace_ms": 500,
    "p2p": {
      "max_fanout_concurrency": 8,
      "max_fanout_bytes": 4194304,
      "max_fanout_ms": 20000,
      "max_response_bytes": 65536
    },
    "topics": {
      "max_msg_bytes": 4096,
      "max_msgs_per_s": 2
    }
  },
  "artifact": {
    "sha256": "b6d5ca9947dc6aba2a9d4783c0b37676890d48e872df5d6edc47592473afa6c6",
    "bytes": 658269,
    "locations": [
      {
        "kind": "https",
        "url": "https://github.com/Avarok-Cybersecurity/citadel-workspace/raw/master/apps/first-party/compute-pool/wasm/compute-pool.wasm"
      }
    ]
  }
}
