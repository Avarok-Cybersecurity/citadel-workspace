{
  "format": 1,
  "id": "work.synchronized.app",
  "version": "0.1.0",
  "sdk": {
    "abi": "citadel-app-abi-1",
    "min": "0.1.0",
    "max": "0.x"
  },
  "publisher": {
    "name": "Avarok",
    "mldsa65_public_key": "",
    "contact": "https://avarok.net"
  },
  "name": "synchronized.work",
  "summary": "A synchronized.work project on this page: a live tree of its tasks, the people on them and their agents' progress",
  "description": "Shows the synchronized.work project linked to this page as a live tree of its tasks, the people working on them and their coding agents' progress, and turns the project's events into workspace notifications.\nLink it once with an 8-character code from synchronized.work. Your Citadel agent holds the session to synchronized.work for this app; on a workspace without that, it reads the same project over HTTPS, read-only.\nThis version only shows the project: prompts to agents are sent from synchronized.work.",
  "icon": {
    "png_base64": "",
    "max_bytes": 32768
  },
  "categories": [
    "developer",
    "planning"
  ],
  "audience": {
    "kind": "workspace"
  },
  "surfaces": [
    "node_page",
    "node_tab"
  ],
  "scopes": [
    "node",
    "node_tree"
  ],
  "capabilities": [
    {
      "cap": "canvas",
      "why": "Draws the project's tree and this app's screens",
      "optional": false
    },
    {
      "cap": "citadel.session",
      "why": "Keeps a session from your Citadel agent to synchronized.work for the live tree, its notifications and linking",
      "optional": false,
      "servers": [
        "synchronized.work"
      ]
    },
    {
      "cap": "net.host",
      "why": "Reads the same project over HTTPS from synchronized.work when the workspace cannot give this app a Citadel session",
      "optional": true,
      "hosts": [
        "synchronized.work"
      ]
    },
    {
      "cap": "storage.user",
      "why": "Remembers that you linked this page and which project it shows",
      "optional": false
    },
    {
      "cap": "notifications",
      "why": "Tells you when someone joins, leaves or asks to join a task of yours, or a task is claimed, finished or cancelled",
      "optional": true
    },
    {
      "cap": "clipboard.write",
      "why": "Copies the synchronized.work address when you ask for it",
      "optional": true
    }
  ],
  "limits": {
    "memory_pages": 1024,
    "max_call_rate_per_s": 120,
    "frame_budget_ms": 8,
    "storage_user_bytes": 65536,
    "storage_scope_bytes": 0,
    "close_grace_ms": 500,
    "session": {
      "max_msg_bytes": 65536,
      "max_msgs_per_s": 8
    }
  },
  "artifact": {
