{
  "about": "Every case a secure-link target must get the same verdict for on the server (citadel-workspace-server-kernel/src/kernel/secure_links/target.rs) and in the UI (citadel-workspaces/src/lib/share/target-rules.ts). Both suites read this file. `padTo` appends 'a' to `target` until it is that many bytes long.",
  "cases": [
    { "target": "/workspace", "accepted": true, "reason": "the workspace route" },
    { "target": "/workspace?nodeId=office-1", "accepted": true, "reason": "a node deep link" },
    { "target": "/workspace?nodeId=workspace-root&section=files&path=%2Fdocs", "accepted": true, "reason": "a folder in the file manager" },
    { "target": "/workspace?nodeId=workspace-root&section=files&path=%2Fdocs&item=q3%20plan.pdf", "accepted": true, "reason": "a file in the file manager" },
    { "target": "/workspace?showP2P=true&p2pUser=bob#latest", "accepted": true, "reason": "a peer chat with a fragment" },
    { "target": "/workspace?nodeId=room%2D1", "accepted": true, "reason": "an escaped node id" },
    { "target": "/workspace?nodeId=caf%C3%A9", "accepted": true, "reason": "an escaped UTF-8 node id" },
    { "target": "/workspace?nodeId=a#nodeId=b", "accepted": true, "reason": "a second nodeId in the fragment is not in the query" },
    { "target": "/workspace?next=%5Cevil.example", "accepted": true, "reason": "an escaped backslash is query data, not a path" },
    { "target": "/messages", "accepted": true, "reason": "the messages route" },
    { "target": "/messages?peer=bob", "accepted": true, "reason": "messages with a query" },
    { "target": "/directory", "accepted": true, "reason": "the directory route" },
    { "target": "/directory?q=alice", "accepted": true, "reason": "the directory with a search" },
    { "target": "/groups/abc-123_x", "accepted": true, "reason": "a group by id" },
    { "target": "/groups/a.b%20c", "accepted": true, "reason": "a group id with a dot and an escape" },
    { "target": "/workspace?x=", "padTo": 2048, "accepted": true, "reason": "exactly the byte limit" },

    { "target": "", "accepted": false, "reason": "empty" },
    { "target": "/workspace?x=", "padTo": 2049, "accepted": false, "reason": "one byte over the limit" },
    { "target": "https://evil.example/workspace", "accepted": false, "reason": "an absolute URL" },
    { "target": "http://localhost/workspace", "accepted": false, "reason": "an absolute URL to this host" },
    { "target": "//evil.example/workspace", "accepted": false, "reason": "protocol-relative" },
    { "target": "///evil.example", "accepted": false, "reason": "protocol-relative with an extra slash" },
    { "target": "javascript:alert(1)", "accepted": false, "reason": "a javascript: URL" },
    { "target": "JaVaScRiPt:alert(1)", "accepted": false, "reason": "a javascript: URL in mixed case" },
    { "target": "data:text/html,<script>alert(1)</script>", "accepted": false, "reason": "a data: URL" },
    { "target": "/\\evil.example", "accepted": false, "reason": "a backslash in the path" },
    { "target": "\\\\evil.example/workspace", "accepted": false, "reason": "a leading double backslash" },
    { "target": "/workspace?next=\\evil.example", "accepted": false, "reason": "a backslash in the query" },
    { "target": "/workspace#\\evil", "accepted": false, "reason": "a backslash in the fragment" },
    { "target": "/workspace\n", "accepted": false, "reason": "a trailing newline" },
    { "target": "/work\tspace", "accepted": false, "reason": "a tab" },
    { "target": "/workspace\r?nodeId=a", "accepted": false, "reason": "a carriage return" },
    { "target": "/workspace\u0000", "accepted": false, "reason": "a NUL" },
    { "target": "/workspace\u007f", "accepted": false, "reason": "DEL" },
    { "target": "/workspace ?nodeId=a", "accepted": false, "reason": "a space" },
    { "target": "/workspace?nodeId=café", "accepted": false, "reason": "a raw non-ASCII character" },
    { "target": "/workspace​", "accepted": false, "reason": "a zero-width space" },
    { "target": "workspace", "accepted": false, "reason": "not rooted" },
    { "target": "?nodeId=a", "accepted": false, "reason": "a bare query" },
    { "target": "/admin", "accepted": false, "reason": "an unknown route" },
    { "target": "/Workspace", "accepted": false, "reason": "routes are case-sensitive" },
    { "target": "/workspace/", "accepted": false, "reason": "a trailing slash is a different route" },
    { "target": "/workspace/extra", "accepted": false, "reason": "a sub-path of a route" },
    { "target": "/messagesx", "accepted": false, "reason": "a route name prefix" },
    { "target": "/groups/", "accepted": false, "reason": "a group with no id" },
    { "target": "/groups/..", "accepted": false, "reason": "a group id of .." },
    { "target": "/groups/.", "accepted": false, "reason": "a group id of ." },
    { "target": "/groups/../workspace", "accepted": false, "reason": "a group path that climbs" },
    { "target": "/groups/a/b", "accepted": false, "reason": "a group id with a slash" },
    { "target": "/workspace?nodeId=a&nodeId=b", "accepted": false, "reason": "two nodeIds" },
    { "target": "/workspace?nodeId=", "accepted": false, "reason": "an empty nodeId" },
    { "target": "/messages?nodeId=", "accepted": false, "reason": "an empty nodeId on another route" },
    { "target": "/workspace?nodeId=%zz", "accepted": false, "reason": "a malformed escape" },
    { "target": "/workspace?nodeId=%2", "accepted": false, "reason": "a truncated escape" },
    { "target": "/workspace?nodeId=%+1", "accepted": false, "reason": "an escape whose first digit is a sign" },
    { "target": "/workspace?nodeId=%ff", "accepted": false, "reason": "an escape that is not UTF-8" }
  ]
}
