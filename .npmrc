# Refuse to install on a Node older than `engines` allows.
#
# `engines: ">=20"` in package.json is advisory by default: npm prints nothing
# and installs anyway. The build then runs most of the way and dies inside a
# transitive dependency with `ReferenceError: crypto is not defined` — the Web
# Crypto global Node added in 19 — and the stack trace passes through
# @rollup/plugin-terser, so it reads as a missing terser dependency. That cost
# an hour to diagnose, twice.
#
# With this, `npm ci` on Node 18 fails immediately and names the version.
engine-strict=true
