# Volume backups. scripts/backup-volumes.sh defaults here, and these archives
# contain internal_service_data -- every user's account keys, which INSTALL.md
# states are unrecoverable and held nowhere else. commit.sh runs `git add
# --all`, so an untracked tarball of them is one command from being committed.
backups/
