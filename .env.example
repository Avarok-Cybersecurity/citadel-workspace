# Internal service WebSocket port
INTERNAL_SERVICE_PORT=12345

# Workspace master password - used for first-time workspace initialization.
# Generate a strong random password for production and REPLACE the whole
# value below:
#   openssl rand -hex 32
# The placeholder is the single inert token `__CHANGE_ME__` (no trailing
# prose to accidentally leave behind as the password). Both deploy.sh and
# the server reject any value still containing `__CHANGE_ME__`, so an
# unmodified .env fails loudly instead of shipping a guessable default.
WORKSPACE_MASTER_PASSWORD=__CHANGE_ME__

# WebSocket URL the production UI build embeds at compile time. Vite
# substitutes `import.meta.env.VITE_WS_URL` during `npm run build`, so
# this MUST be set BEFORE `docker compose -f docker-compose.production.yml
# build ui`. Leave empty for local dev (frontend falls back to
# `ws://localhost:12345`); for production behind Cloudflare tunnel, set
# to the same-origin path the tunnel routes to the internal service,
# e.g. `wss://yourdomain.com/ws`. The nginx CSP `connect-src 'self'`
# blocks any cross-origin WebSocket — the browser will refuse to
# connect if VITE_WS_URL points off-origin.
VITE_WS_URL=

# Cloudflare Tunnel token (production only, used with --profile tunnel)
# Create at: https://one.dash.cloudflare.com → Networks → Tunnels
# TUNNEL_TOKEN=your-tunnel-token-here

# Absolute path to the file deploy.sh locks to serialize deployments of this compose project.
#
# Leave unset and each account locks under its own $HOME, which serializes everything that account
# deploys - every checkout, cron run and interactive run - but NOT a second account deploying the
# same project. That matters because the deploy removes containers selected by the compose project
# label, which is shared across the whole daemon.
#
# It does NOT authorize removing containers for services a slimmed compose file drops. Supplying
# a path proves one was chosen, not that every deployment of this project chose the same one - two
# accounts could each set a different valid path and hold two locks at once. Only the CANONICAL
# path below establishes that, and only it enables cleanup.
#DEPLOY_LOCK_FILE=

# ---------------------------------------------------------------------------
# Canonical lock: /run/lock/citadel-deploy/<compose-project>.lock
# ---------------------------------------------------------------------------
# Not configurable per deploy, on purpose - being a constant is what makes it a guarantee. When it
# exists and is writable, every deploy of this project on this host contends on one inode, and
# only then will a deploy retire containers for services the compose file no longer declares.
# Without it, a deploy that would need to retire something REFUSES before pulling or restarting
# anything, and tells you this.
#
# Provision the FILE as well as the directory: whichever account opened it first would otherwise
# create it with its own umask (0644) and lock every other account out.
#   sudo install -d -o root -g docker -m 2775 /run/lock/citadel-deploy
#   sudo install -o root -g docker -m 0664 /dev/null /run/lock/citadel-deploy/citadel-workspace.lock
#
# /run/lock is a tmpfs cleared on reboot, so persist both in /etc/tmpfiles.d/citadel-deploy.conf:
#   d /run/lock/citadel-deploy 2775 root docker -
#   f /run/lock/citadel-deploy/citadel-workspace.lock 0664 root docker -
#
# CITADEL_DEPLOY_LOCK_ROOT relocates the directory for hosts without /run/lock. It is host policy:
# if you change it, change it for every deploy of the project, or they stop contending.

# Seconds to wait for that lock before giving up. 0 (the default) fails immediately, which suits
# an interactive operator. A scheduled deploy that can legitimately overlap a long one should set
# this so it queues instead of raising a failed-deployment alert.
#DEPLOY_LOCK_TIMEOUT=0
