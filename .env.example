# Internal service WebSocket port
INTERNAL_SERVICE_PORT=12345

# Workspace master password - used for first-time workspace initialization.
# Generate a strong random password for production and REPLACE the whole
# value below:
#   openssl rand -hex 32
# The placeholder is the single inert token `__CHANGE_ME__` (no trailing
# prose to accidentally leave behind as the password). Both deploy.sh and
# the server reject any value still containing `__CHANGE_ME__`, so an
# unmodified .env fails loudly instead of shipping a guessable default.
WORKSPACE_MASTER_PASSWORD=__CHANGE_ME__

# Which page origins may drive the internal service over its WebSocket.
#
# REQUIRED in production: docker-compose.production.yml passes this through with
# no fallback, and the service refuses to start without it. That is deliberate —
# a default would either be wrong for every real deployment (localhost) or be
# the hole itself (any origin). The agent it fronts can enumerate every account
# with GetSessions and act as them, so any page allowed here can do the same.
#
# Comma-separated origins, scheme and port included, e.g.
#   INTERNAL_SERVICE_ALLOWED_ORIGINS=https://yourdomain.com
# `*` accepts any origin and logs a loud security warning at startup; it exists
# for local experiments, not for deployments. `*` mixed with a list is rejected
# rather than silently widening the list to everything.
#
# The dev compose files set this for you (localhost:5291 / :8080); only the
# production file reads it from here.
INTERNAL_SERVICE_ALLOWED_ORIGINS=

# REQUIRED by ./deploy.sh when this deployment serves the UI. The wss:// origin
# of each visitor's OWN agent, which the page dials and its CSP allows. Empty,
# the page loads and can connect to nothing. The released agent has a
# certificate for local.avarok.net (A record 127.0.0.1) only, so that is the
# value unless your testers run the agent with --tls-cert/--tls-key for a name
# of your own. See docs/INSTALL.md.
#   LOOPBACK_AGENT_ORIGIN=wss://local.avarok.net:12345
LOOPBACK_AGENT_ORIGIN=

# Set to 1 only to start a server against a backend whose schema is NEWER than
# the binary understands — i.e. a deliberate downgrade. Refused by default,
# because a newer migration may have rewritten keys this binary cannot read, and
# starting anyway risks corrupting them. Leave unset unless you are downgrading
# on purpose and have a backup.
# WORKSPACE_ALLOW_SCHEMA_DOWNGRADE=1

# Cloudflare Tunnel token (production only, used with --profile tunnel)
# Create at: https://one.dash.cloudflare.com → Networks → Tunnels
# TUNNEL_TOKEN=your-tunnel-token-here
